# Jira: địa chỉ site và tài khoản dịch vụ HUB (email + API token)
JIRA_BASE_URL=https://<ten-site>.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=CQ

# Dùng chung cho R1, R6 và pg_cron. Tạo bằng: openssl rand -hex 24
HUB_SHARED_SECRET=

# Jev (TypeSafe AI). Ghim phiên bản model để hành vi không tự đổi
TYPESAFE_API_KEY=
JEV_MODEL=

# Supabase: chỉ dùng phía server
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

APP_TIMEZONE=Asia/Ho_Chi_Minh
